# SQLAlchemy URL. SQLite for local demo; Postgres for pilot, e.g. postgresql+psycopg://user:pass@localhost/voiceid
DATABASE_URL=sqlite:///./voiceid.db

# Fernet key for encrypting voice templates at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a dev key is created in backend/.dev_template_key (never do this in production).
TEMPLATE_ENCRYPTION_KEY=

# Speaker embedding backend: sherpa-onnx (default, CPU, no torch) or speechbrain (Linux/Docker)
EMBEDDER_BACKEND=sherpa-onnx
SPEAKER_MODEL_PATH=models/3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx

# Decision thresholds (cosine similarity)
MATCH_ACCEPT_THRESHOLD=0.55
MATCH_STEPUP_THRESHOLD=0.40
SPOOF_STEPUP_THRESHOLD=0.60
SPOOF_REJECT_THRESHOLD=0.90

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Optional shared secret required in the X-API-Key header by every client (web dashboard, mobile app).
API_KEY=

# Extra added to MATCH_ACCEPT_THRESHOLD for high-risk contexts (large transfers, beneficiary changes, recovery)
HIGH_RISK_ACCEPT_MARGIN=0.05

# Mule-network detection
NETWORK_ID_PEPPER=change-me-before-real-data
NETWORK_SIMULATION_ENABLED=true
NETWORK_HOME_BANK_CODE=999
NETWORK_HOME_BANK_NAME=TheOne Demo Bank

# Sender-side payment risk (KYC limits are placeholders: confirm against current CBN rules)
NETWORK_REVIEW_CAP_NAIRA=100000000
NETWORK_NEW_PAYEE_NAIRA=200000
NETWORK_THIN_FILE_NAIRA=1000000
NETWORK_KYC_DAILY_LIMITS=1:50000,2:200000
NETWORK_REQUIRE_ATTESTED_DEVICE=true

# Operating mode and bank connection
NETWORK_MODE=enforce            # or shadow: score and record, never act at the bank
NETWORK_BANK_CONNECTOR=none     # or obn
NETWORK_OBN_BASE_URL=http://localhost:8000/mock-obn
NETWORK_OBN_CLIENT_ID=theone-demo
NETWORK_OBN_CLIENT_SECRET=theone-demo-secret
NETWORK_LEARNING_ENABLED=true
# Role keys: key:role pairs (system, app, analyst, supervisor, admin)
API_KEYS=
